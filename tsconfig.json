{
  "compilerOptions": {
    "target": "ES2020",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "lib": ["ES2020", "DOM"]
  },
  "include": [
    "amd/src/**/*.js",
    "amd/src/**/*.d.ts"
  ],
  "exclude": [
    "amd/build/**",
    "vendor/**",
    "node_modules/**",
    "MAMP local Moodle, htdocs/**"
  ]
}
