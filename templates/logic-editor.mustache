{{!
    Template of the Logic Circuit question type.

    @package    qtype_logiccircuit/save-result
    @copyright  2025 Groupe Modulo
    @license    CC BY-NC-SA
}}
{{!
    @template qtype_logiccircuit/logic-editor
}}

<div class="qtype_logiccircuit">

    <p>{{{question_text}}}</p>

    {{#readonly}}
        <div style="width: 100%; height: 40rem; max-height: 40rem;">
            <logic-editor mode="tryout" outputdefault="?" striptags="key" showdisconnectedpins norestore>
                <script type="application/json5">
                    {{#answer_value}}
                        {{{answer_value}}}
                    {{/answer_value}}

                    {{^answer_value}}
                        {{{init_state}}}
                    {{/answer_value}}
                </script>
            </logic-editor>
        </div>

        <div class="d-flex ustify-content-start align-items-center">
            <button
                type="button"
                class="btn btn-secondary mt-3 unlock-circuit-button"
                aria-label="{{#str}} unlockcircuit, qtype_logiccircuit {{/str}}">
                {{#str}} unlockcircuit, qtype_logiccircuit {{/str}}
            </button>
        </div>

        {{#readonly_test_results}}
            <details class="mt-3">
                <summary class="fw-bold" style="cursor: pointer;">
                    {{#str}} submittedtestresultsjson, qtype_logiccircuit {{/str}}
                </summary>

                <div class="mt-2" style="white-space: pre-line;">
                    {{{readonly_test_results}}}
                </div>
            </details>
        {{/readonly_test_results}}

        {{#readonly_answer_pre}}
            <details class="mt-3">
                <summary class="fw-bold" style="cursor: pointer;">
                    {{#str}} submittedcircuitjson, qtype_logiccircuit {{/str}}
                </summary>

                <div class="mt-2">
                    {{{readonly_answer_pre}}}
                </div>
            </details>
        {{/readonly_answer_pre}}
    {{/readonly}}

    {{^readonly}}
        <div style="width: 100%; height: 40rem; max-height: 40rem;">
            {{#editor_mode}}
                <logic-editor outputdefault="?" striptags="key" norestore mode="connect">
                    <script type="application/json5">
                        {{#answer_value}}
                            {{{answer_value}}}
                        {{/answer_value}}

                        {{^answer_value}}
                            {{{init_state}}}
                        {{/answer_value}}
                    </script>
                </logic-editor>
            {{/editor_mode}}
            {{^editor_mode}}
                <logic-editor outputdefault="?" striptags="key" norestore mode="design" showonly="{{components_to_show}}">
                    <script type="application/json5">
                        {{#answer_value}}
                            {{{answer_value}}}
                        {{/answer_value}}

                        {{^answer_value}}
                            {{{init_state}}}
                        {{/answer_value}}
                    </script>
                </logic-editor>
            {{/editor_mode}}
        </div>

        <div class="d-flex justify-content-between" style="margin: 1rem 0 0.5rem;">
            <div class="d-flex ustify-content-start align-items-center">
                <button
                    type="button"
                    class="btn btn-info circuit-run-test-button"
                    aria-label="{{#str}} runtests, qtype_logiccircuit {{/str}}">
                    {{#str}} saveandruntests, qtype_logiccircuit {{/str}}
                </button>
                <span
                    class="text-warning result_not_uploaded"
                    style="margin-left: 1rem; display: none;"
                    role="status">
                    <i class="fa fa-warning" aria-hidden="true"></i>
                    {{#str}} resultnotuploaded, qtype_logiccircuit {{/str}}
                </span>
                <span
                    class="text-info new_result_uploaded"
                    style="margin-left: 1rem; display: none;"
                    role="status">
                    <i class="fa fa-cloud-upload" aria-hidden="true"></i>
                    {{#str}} resultuploaded, qtype_logiccircuit {{/str}}
                </span>
            </div>

            <button
                type="button"
                class="btn btn-warning circuit-reset-button"
                aria-label="{{#str}} resetthecircuit, qtype_logiccircuit {{/str}}"
                data-init-state="{{init_state}}">
                {{#str}} resetthecircuit, qtype_logiccircuit {{/str}}
            </button>
        </div>

        <textarea
            name="{{answer_input_name}}"
            class="answer"
            style="display: none;">{{answer_value}}
        </textarea>
        <textarea
            name="{{test_results_input_name}}"
            class="test-results"
            style="display: none;">{{test_results_value}}
        </textarea>
    {{/readonly}}


    {{#is_debug}}
        <div>
            <h1>DEBUG</h1>
                'question_name' => $question_name,
                'question_text' => $question_text,
                'init_state' => $init_state,
                'answer_name' => $answer_input_name,
                'test_results_name' => $test_results_input_name,
                'answer_value' => $current_answer,
                'test_results_value' => $current_test_results,
            <p>QUESTION NAME: {{question_name}}</p>
            <p>QUESTION TEXT: {{question_text}}</p>
            <p>EDITOR_MODE: {{editor_mode}}</p>
            <p>COMPONENTS_TO_SHOW: {{components_to_show}}</p>
            <p>INIT STATE: {{{init_state}}}</p>
            <p>ANSWER INPUT NAME: {{answer_input_name}}</p>
            <p>TEST RESULTS INPUT NAME: {{test_results_input_name}}</p>
            <p>ANSWER VALUE: {{{answer_value}}}</p>
            <p>TEST RESULTS VALUE: {{{test_results_value}}}</p>
        </div>
    {{/is_debug}}

</div>
